{
	"name": "SpreadsheetEditor",
	"version": "2.0.0",
	"requires": {
		"MediaWiki": ">= 1.35",
		"extensions": {
			"MwJson": ">= 0.6.0"
		}
	},
	"author": [
		"Simon Stier"
	],
	"url": "https://github.com/OpenSemanticLab/mediawiki-extensions-SpreadsheetEditor",
	"descriptionmsg": "spreadsheeteditor-desc",
	"license-name": "AGPL v3",
	"type": "other",
	"AutoloadClasses": {
		"SpreadsheetEditorHooks": "SpreadsheetEditor.hooks.php",
		"SpecialSpreadsheetEditor": "specials/SpecialSpreadsheetEditor.php"
	},
	"config": {
		"SpreadsheetEditorEnableFoo": true
	},
	"ExtensionMessagesFiles": {
		"SpreadsheetEditorAlias": "SpreadsheetEditor.i18n.alias.php",
		"SpreadsheetEditorMagic": "SpreadsheetEditor.i18n.magic.php"
	},
	"Hooks": {
		
		"ParserFirstCallInit": ["SpreadsheetEditorHooks::onParserFirstCallInit"],
		"BeforePageDisplay": ["SpreadsheetEditorHooks::onBeforePageDisplay"]
	},
	"MessagesDirs": {
		"SpreadsheetEditor": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.SpreadsheetEditor.adapter": {
			"scripts": [
				"modules/ext.SpreadsheetEditor.adapter.js"
			]
		},
		"ext.SpreadsheetEditor": {
			"scripts": [
				"modules/ext.SpreadsheetEditor.js"
			],
			"styles": [
				"modules/ext.SpreadsheetEditor.css"
			],
			"messages": [
				"spreadsheeteditor-button-edit",
				"spreadsheeteditor-button-show-labels",
				"spreadsheeteditor-button-autocompletion",
				"spreadsheeteditor-button-import-xlsx",
				"spreadsheeteditor-button-export-xlsx",
				"spreadsheeteditor-button-save",
				"spreadsheeteditor-button-close",
				"spreadsheeteditor-ac-title",
				"spreadsheeteditor-ac-empty-list",
				"spreadsheeteditor-ac-range",
				"spreadsheeteditor-ac-range-placeholder",
				"spreadsheeteditor-ac-label",
				"spreadsheeteditor-ac-label-placeholder",
				"spreadsheeteditor-ac-category",
				"spreadsheeteditor-ac-category-placeholder",
				"spreadsheeteditor-ac-category-hint",
				"spreadsheeteditor-ac-query",
				"spreadsheeteditor-ac-query-hint",
				"spreadsheeteditor-ac-default",
				"spreadsheeteditor-ac-default-placeholder",
				"spreadsheeteditor-ac-default-hint",
				"spreadsheeteditor-ac-add",
				"spreadsheeteditor-ac-remove",
				"spreadsheeteditor-ac-done",
				"spreadsheeteditor-ac-range-required",
				"spreadsheeteditor-popup-search",
				"spreadsheeteditor-popup-no-matches",
				"spreadsheeteditor-popup-hint",
				"spreadsheeteditor-notify-editor-open",
				"spreadsheeteditor-notify-unsupported-file",
				"spreadsheeteditor-notify-no-workbook",
				"spreadsheeteditor-notify-not-ready",
				"spreadsheeteditor-notify-imported",
				"spreadsheeteditor-notify-save-error",
				"spreadsheeteditor-notify-import-failed",
				"spreadsheeteditor-notify-export-failed"
			],
			"dependencies": [
				"ext.SpreadsheetEditor.adapter",
				"ext.mwjson.api",
				"ext.mwjson.util",
				"oojs-ui-core"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "SpreadsheetEditor"
	},
	"SpecialPages": {
		"SpreadsheetEditor": "SpecialSpreadsheetEditor"
	},
	"manifest_version": 1
}
